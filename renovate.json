{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", ":semanticCommits"],
  "timezone": "Europe/Rome",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "7 days",
  "prConcurrentLimit": 5,
  "labels": ["chore", "no-changeset"],
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "One weekly PR for all non-major updates",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "GitHub Actions in their own group",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "TypeScript stays on 6.0 until typescript-eslint supports 7 (ADR-0003)",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0"
    }
  ]
}
