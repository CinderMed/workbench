# Copy to .env to override the Docker Compose defaults. Never commit .env.
# The defaults are for local development only.

# --- Variables read by the API (specification, "Docker Compose") ---
DATABASE_URL=postgres://cindermed:cindermed-dev@db:5432/cindermed
OIDC_ISSUER=http://localhost:8081/realms/cindermed
OIDC_CLIENT_ID=cindermed-web
# BioPortal API key (terminology search, module 8)
BIOPORTAL_API_KEY=
# Free LOINC account for fhir.loinc.org (module 8)
LOINC_USERNAME=
LOINC_PASSWORD=
# Matchbox, V2 conversion module
MATCHBOX_URL=
FHIR_PACKAGE_REGISTRY=https://packages.fhir.org

# --- Development stack ---
POSTGRES_PASSWORD=cindermed-dev
KEYCLOAK_ADMIN_PASSWORD=admin-dev
# Password of the realm's test users: owner, mapper, reviewer, engineer, viewer
CINDERMED_DEV_PASSWORD=cindermed-dev
WEB_PORT=8080
API_PORT=3000
KEYCLOAK_PORT=8081
