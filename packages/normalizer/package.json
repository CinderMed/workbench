{
  "name": "@cindermed/normalizer",
  "version": "0.2.0",
  "private": true,
  "description": "Reference normalizer for tabular source rows",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CinderMed/workbench.git",
    "directory": "packages/normalizer"
  },
  "homepage": "https://github.com/CinderMed/workbench/tree/main/packages/normalizer#readme",
  "bugs": {
    "url": "https://github.com/CinderMed/workbench/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cindermed/model": "workspace:*",
    "@noble/hashes": "2.4.0"
  }
}
