{
  "name": "@cindermed/model",
  "version": "0.6.0",
  "private": true,
  "description": "Project JSON Schemas, generated types and integrity rules",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CinderMed/workbench.git",
    "directory": "packages/model"
  },
  "homepage": "https://github.com/CinderMed/workbench/tree/main/packages/model#readme",
  "bugs": {
    "url": "https://github.com/CinderMed/workbench/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "codegen": "node ../../tooling/codegen/model-types-cli.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
