{
  "name": "@cindermed/fml",
  "version": "0.3.0",
  "private": true,
  "description": "FML syntax tree, printer, project-to-FML generator and grammar check",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CinderMed/workbench.git",
    "directory": "packages/fml"
  },
  "homepage": "https://github.com/CinderMed/workbench/tree/main/packages/fml#readme",
  "bugs": {
    "url": "https://github.com/CinderMed/workbench/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./grammar": {
      "types": "./dist/grammar.d.ts",
      "default": "./dist/grammar.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cindermed/model": "workspace:*",
    "antlr4ng": "3.0.16"
  }
}
