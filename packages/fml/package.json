{
  "name": "@cindermed/fml",
  "version": "0.0.0",
  "private": true,
  "description": "FML syntax tree, printer, project-to-FML generator and grammar check",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
