{
  "name": "@cindermed/export",
  "version": "0.2.1",
  "private": true,
  "description": "FML package with manifest, CSV/Excel and project JSON export",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CinderMed/workbench.git",
    "directory": "packages/export"
  },
  "homepage": "https://github.com/CinderMed/workbench/tree/main/packages/export#readme",
  "bugs": {
    "url": "https://github.com/CinderMed/workbench/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cindermed/fhir-defs": "workspace:*",
    "@cindermed/fml": "workspace:*",
    "@cindermed/model": "workspace:*",
    "@noble/hashes": "2.4.0",
    "fflate": "0.8.3"
  }
}
