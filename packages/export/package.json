  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cindermed/fml": "workspace:*",
    "@cindermed/model": "workspace:*",
    "@noble/hashes": "2.4.0",
    "fflate": "0.8.3"
  }
}
