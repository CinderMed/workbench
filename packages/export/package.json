{
  "name": "@cindermed/export",
  "version": "0.0.0",
  "private": true,
  "description": "FML package with manifest, CSV/Excel and project JSON export",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
