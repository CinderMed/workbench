{
  "realm": "cindermed",
  "displayName": "CinderMed (development)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "cindermed-web",
      "name": "CinderMed web app",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${CINDERMED_WEB_URL}/*", "http://localhost:5173/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${CINDERMED_WEB_URL}/*##http://localhost:5173/*"
      }
    }
  ],
  "users": [
    {
      "username": "owner",
      "email": "owner@cindermed.test",
      "emailVerified": true,
      "firstName": "Olga",
      "lastName": "Owner",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${CINDERMED_DEV_PASSWORD}",
          "temporary": false
        }
      ],
      "attributes": {
        "cindermed.devRole": ["owner"]
      }
    },
    {
      "username": "mapper",
      "email": "mapper@cindermed.test",
      "emailVerified": true,
      "firstName": "Marco",
      "lastName": "Mapper",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${CINDERMED_DEV_PASSWORD}",
          "temporary": false
        }
      ],
      "attributes": {
        "cindermed.devRole": ["mapper"]
      }
    },
    {
