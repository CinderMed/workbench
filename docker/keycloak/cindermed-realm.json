      "email": "reviewer@cindermed.test",
      "emailVerified": true,
      "firstName": "Rita",
      "lastName": "Reviewer",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${CINDERMED_DEV_PASSWORD}",
          "temporary": false
        }
      ],
      "attributes": {
        "cindermed.devRole": ["reviewer"]
      }
    },
