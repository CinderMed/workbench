{
  "name": "@cindermed/api",
  "version": "0.0.0",
  "private": true,
  "description": "CinderMed REST API (Fastify)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js",
    "dev": "node --watch --experimental-strip-types src/server.ts"
  },
  "dependencies": {
    "fastify": "^5.12.8"
  }
}
