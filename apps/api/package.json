{
  "name": "@cindermed/api",
  "version": "0.5.0",
  "private": true,
  "description": "CinderMed REST API (Fastify)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js",
    "dev": "node --watch --experimental-strip-types src/server.ts"
  },
  "dependencies": {
    "@cindermed/model": "workspace:*",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.3",
    "fastify": "5.12.8",
    "jose": "6.2.17",
    "kysely": "0.28.20",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
