{
  "name": "@cindermed/cli",
  "version": "0.5.0",
  "private": true,
  "description": "The cindermed command-line tool (validate, export)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CinderMed/workbench.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/CinderMed/workbench/tree/main/apps/cli#readme",
  "bugs": {
    "url": "https://github.com/CinderMed/workbench/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "bin": {
    "cindermed": "./dist/bin.js"
  },
  "dependencies": {
    "@cindermed/export": "workspace:*",
    "@cindermed/fhir-defs": "workspace:*",
    "@cindermed/model": "workspace:*",
    "@cindermed/normalizer": "workspace:*",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "fflate": "0.8.3"
  }
}
