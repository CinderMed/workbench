{
  "name": "@cindermed/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The cindermed command-line tool (validate, export)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "bin": {
    "cindermed": "./dist/bin.js"
  },
  "dependencies": {
    "@cindermed/model": "workspace:*"
  }
}
