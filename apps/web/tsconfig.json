{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "src",
    "vite.config.ts",
    "vite-localhost.ts",
    "vite-fhir-index.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
