  "text" : {
    "status" : "additional",
    "div" : "<div xmlns=\"http://www.w3.org/1999/xhtml\"><pre>map &quot;http://example.org/fhir/motu/StructureMap/HospitalStay&quot; = `HospitalStay`\n\nuses &quot;http://example.org/fhir/motu/StructureDefinition/HospitalStayRow&quot; alias HospitalStayRow as source\nuses &quot;http://hl7.org/fhir/StructureDefinition/Bundle&quot; alias Bundle as target\nuses &quot;http://hl7.org/fhir/StructureDefinition/Encounter&quot; alias Encounter as target\n\n// Main group: one transaction Bundle per normalized record.\n// Each role becomes an entry with PUT on its deterministic id (computed by the normalization).\ngroup HospitalStay(source src : HospitalStayRow, target bundle : Bundle) {\n  src -&gt; bundle.type = 'transaction' &quot;bundle-type&quot;;\n  // Encounter[0] · hospital stay — created when: AdmissionDate is not empty\n  src where ($this.id_Encounter0.exists() and $this.AdmissionDate.exists()) -&gt; bundle.entry as e, e.resource = create('Encounter') as res, e.request as req then {\n    src.id_Encounter0 as i -&gt; res.id = i, req.method = 'PUT', req.url = evaluate(i, 'Encounter/' + $this), e.fullUrl = evaluate(i, 'http://example.org/fhir/motu/Encounter/' + $this) &quot;Encounter0-id&quot;;\n    src then Encounter0(src, res) &quot;Encounter0-body&quot;;\n  } &quot;Encounter0&quot;;\n}\n\ngroup Encounter0(source src : HospitalStayRow, target res : Encounter) {\n  src -&gt; res.status = 'finished' &quot;fixed-status&quot;;\n  src -&gt; res.class = c('http://terminology.hl7.org/CodeSystem/v3-ActCode', 'IMP', 'inpatient encounter') &quot;fixed-class&quot;;\n  // period: written by 2 rows (R-004, R-005) → one shared instance\n  src where ($this.AdmissionDate.exists() or $this.DischargeDate.exists()) -&gt; res.period as p then {\n    src.AdmissionDate as v -&gt; p.start = v &quot;R-004&quot;;\n    src.DischargeDate as v -&gt; p.end = v &quot;R-005&quot;;\n  } &quot;Encounter0-period&quot;;\n  // R-006 reference to Patient[0] in another table (via rel_stay_patient): the resource must already be loaded\n  src.id_Patient0 as t -&gt; res.subject as r, r.reference = evaluate(t, 'Patient/' + $this) &quot;R-006&quot;;\n}\n</pre></div>"
  },
