{
  "resourceType" : "StructureMap",
  "id" : "Patients",
  "text" : {
    "status" : "additional",
    "div" : "<div xmlns=\"http://www.w3.org/1999/xhtml\"><pre>map &quot;http://example.org/fhir/mimic-iv-demo/StructureMap/Patients&quot; = `Patients`\n\nuses &quot;http://example.org/fhir/mimic-iv-demo/StructureDefinition/PatientsRow&quot; alias PatientsRow as source\nuses &quot;http://hl7.org/fhir/StructureDefinition/Bundle&quot; alias Bundle as target\nuses &quot;http://hl7.org/fhir/StructureDefinition/Patient&quot; alias Patient as target\n\n// Main group: one transaction Bundle per normalized record.\n// Each role becomes an entry with PUT on its deterministic id (computed by the normalization).\ngroup Patients(source src : PatientsRow, target bundle : Bundle) {\n  src -&gt; bundle.type = 'transaction' &quot;bundle-type&quot;;\n  // Patient[0] · patient — always\n  src where ($this.id_Patient0.exists()) -&gt; bundle.entry as e, e.resource = create('Patient') as res, e.request as req then {\n    src.id_Patient0 as i -&gt; res.id = i, req.method = 'PUT', req.url = evaluate(i, 'Patient/' + $this), e.fullUrl = evaluate(i, 'http://example.org/fhir/mimic-iv-demo/Patient/' + $this) &quot;Patient0-id&quot;;\n    src then Patient0(src, res) &quot;Patient0-body&quot;;\n  } &quot;Patient0&quot;;\n}\n\ngroup Patient0(source src : PatientsRow, target res : Patient) {\n  // identifier: written by 2 rows (R-001, R-002) → one shared instance\n  src where ($this.subject_id.exists()) -&gt; res.identifier as p then {\n    src -&gt; p.system = 'http://mimic.mit.edu/fhir/mimic/identifier/patient' &quot;R-001&quot;;\n    src.subject_id as v -&gt; p.value = v &quot;R-002&quot;;\n  } &quot;Patient0-identifier&quot;;\n  // R-003: value map gender (one rule per value; ConceptMap exported separately)\n  src.gender as v where ($this = 'F') -&gt; res.gender = 'female' &quot;R-003-F&quot;;\n  src.gender as v where ($this = 'M') -&gt; res.gender = 'male' &quot;R-003-M&quot;;\n}\n</pre></div>"
  },
