{
  "resourceType" : "StructureMap",
  "id" : "Admissions",
  "text" : {
    "status" : "additional",
    "div" : "<div xmlns=\"http://www.w3.org/1999/xhtml\"><pre>map &quot;http://example.org/fhir/mimic-iv-demo/StructureMap/Admissions&quot; = `Admissions`\n\nuses &quot;http://example.org/fhir/mimic-iv-demo/StructureDefinition/AdmissionsRow&quot; alias AdmissionsRow as source\nuses &quot;http://hl7.org/fhir/StructureDefinition/Bundle&quot; alias Bundle as target\nuses &quot;http://hl7.org/fhir/StructureDefinition/Encounter&quot; alias Encounter as target\n\n// Main group: one transaction Bundle per normalized record.\n// Each role becomes an entry with PUT on its deterministic id (computed by the normalization).\ngroup Admissions(source src : AdmissionsRow, target bundle : Bundle) {\n  src -&gt; bundle.type = 'transaction' &quot;bundle-type&quot;;\n  // Encounter[0] · hospital admission — always\n  src where ($this.id_Encounter0.exists()) -&gt; bundle.entry as e, e.resource = create('Encounter') as res, e.request as req then {\n    src.id_Encounter0 as i -&gt; res.id = i, req.method = 'PUT', req.url = evaluate(i, 'Encounter/' + $this), e.fullUrl = evaluate(i, 'http://example.org/fhir/mimic-iv-demo/Encounter/' + $this) &quot;Encounter0-id&quot;;\n    src then Encounter0(src, res) &quot;Encounter0-body&quot;;\n  } &quot;Encounter0&quot;;\n}\n\ngroup Encounter0(source src : AdmissionsRow, target res : Encounter) {\n  src -&gt; res.status = 'finished' &quot;fixed-status&quot;;\n  // identifier: written by 2 rows (R-004, R-005) → one shared instance\n  src where ($this.hadm_id.exists()) -&gt; res.identifier as p then {\n    src -&gt; p.system = 'http://mimic.mit.edu/fhir/mimic/identifier/encounter-hosp' &quot;R-004&quot;;\n    src.hadm_id as v -&gt; p.value = v &quot;R-005&quot;;\n  } &quot;Encounter0-identifier&quot;;\n  // R-006: value map admissionClass (one rule per value; ConceptMap exported separately)\n  src.admission_type as v where ($this = 'URGENT') -&gt; res.class = c('http://terminology.hl7.org/CodeSystem/v3-ActCode', 'AMB', 'ambulatory') &quot;R-006-URGENT&quot;;\n  src.admission_type as v where ($this = 'EW EMER.') -&gt; res.class = c('http://terminology.hl7.org/CodeSystem/v3-ActCode', 'EMER', 'emergency') &quot;R-006-EW-EMER.&quot;;\n  // R-007 reference to Patient[0] in another table (via rel_admissions_patients): the resource must already be loaded\n  src.id_Patient0 as t -&gt; res.subject as r, r.reference = evaluate(t, 'Patient/' + $this) &quot;R-007&quot;;\n}\n</pre></div>"
  },
