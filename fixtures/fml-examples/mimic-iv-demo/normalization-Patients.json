{
  "$schema": "../normalization.schema.json",
  "formatVersion": "1.2.0",
  "source": "Patients",
  "logicalModel": "http://example.org/fhir/mimic-iv-demo/StructureDefinition/PatientsRow",
  "input": {
    "format": "csv",
    "delimiter": ",",
    "encoding": "utf-8",
    "headerRow": 1
  },
  "onInvalidValue": "fail",
  "columns": [
    {
      "name": "subject_id",
      "sourceName": "subject_id",
      "type": "string"
    },
    {
      "name": "gender",
      "sourceName": "gender",
      "type": "string",
      "allowedValues": [
        "F",
        "M"
      ]
    }
  ],
  "ids": [
    {
      "field": "id_Patient0",
      "literals": [
        "pat"
      ],
      "columns": [
        "subject_id"
      ],
      "encoding": "hash",
      "hashLength": 24,
      "separator": "-"
    }
  ],
  "hash": {
    "algorithm": "sha256"
  }
}