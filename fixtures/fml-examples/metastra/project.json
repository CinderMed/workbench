        "col_patient_id"
      ],
      "import": {
        "fileName": "Dictionary_METASTRA_FHIR_Last.xlsx",
        "sheet": "FirstOverview",
        "fileKind": "dictionary",
        "headerRow": 2,
        "columnRoles": {
          "Label": "label",
          "Description": "description",
          "Variable": "name",
          "Data Type": "dataType",
          "Default values": "valueLabel",
          "REDCap code": "valueCode",
          "Resource": "ignore"
        },
        "continuationRows": "allowedValuesOfPrevious",
        "typeRules": {
          "list, single choice": "categorical",
          "yes/no": "categorical",
          "list, multiple choice": "multipleChoice",
          "number": "decimal",
          "float": "decimal",
          "text": "string"
        },
        "importedAt": "2026-11-09T15:05:00Z"
      },
      "sections": [
        {
          "id": "sec_demo",
          "name": "Demographic data",
          "order": 1
        },
        {
          "id": "sec_osteo",
          "name": "Osteporosis/Osteopenia",
          "order": 2
        },
        {
          "id": "sec_pain",
          "name": "Pain",
          "order": 3
        },
        {
          "id": "sec_blood",
          "name": "Blood test",
          "order": 4
        }
      ],
      "columns": [
        {
          "id": "col_patient_id",
          "name": "patient_id",
          "label": "1. Patient ID",
          "description": "Pseudonymised patient identifier, unique in the registry.",
          "dataType": "string",
          "provenance": {
            "kind": "import"
          }
        },
        {
          "id": "col_encounter_fo",
          "name": "encounter_fo",
