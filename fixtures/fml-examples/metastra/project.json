            "kind": "import"
          },
          "dateFormat": "dd/MM/yyyy"
        },
        {
          "id": "col_proc_surg_yn",
          "name": "proc_surg_yn",
          "label": "3. At baseline, has the patient been hospitalized for a surgical spinal treatment?",
          "description": "Whether at baseline the patient has already had spinal surgery.",
          "dataType": "categorical",
          "allowedValues": [
            {
              "code": "1",
              "label": "yes"
            },
            {
              "code": "0",
              "label": "no"
            }
          ],
          "provenance": {
            "kind": "import"
          }
        },
        {
          "id": "col_proc_surg_loc",
          "name": "proc_surg_loc",
          "label": "5.1 Localization of surgically treated lesion",
          "description": "Surgically treated spinal levels; several levels possible.",
          "dataType": "multipleChoice",
          "multiValue": {
            "encoding": "delimited",
            "separator": ","
          },
          "allowedValues": [
            {
              "code": "1",
              "label": "C1"
            },
            {
              "code": "2",
              "label": "C2"
            },
            {
              "code": "8",
              "label": "T1"
            },
            {
              "code": "20",
              "label": "L1"
            }
          ],
          "provenance": {
            "kind": "import"
          }
        },
        {
          "id": "col_gender",
          "name": "patient_gender",
          "label": "6. Gender",
          "description": "Administrative gender of the patient.",
          "sectionId": "sec_demo",
          "dataType": "categorical",
          "allowedValues": [
            {
              "code": "Female",
              "label": "Female"
            },
            {
              "code": "Male",
              "label": "Male"
            }
          ],
          "provenance": {
            "kind": "import"
          }
        },
        {
          "id": "col_birthdate",
          "name": "patient_birthdate",
          "label": "7. Date of birth",
          "description": "Date of birth of the patient.",
          "sectionId": "sec_demo",
          "dataType": "date",
          "provenance": {
            "kind": "import"
          },
          "dateFormat": "dd/MM/yyyy"
        },
        {
          "id": "col_osteo_yn",
          "name": "cond_osteoporosis_yn",
          "label": "14. Osteoporosis",
          "description": "Osteoporosis diagnosis of the patient at the first visit.",
          "sectionId": "sec_osteo",
          "dataType": "categorical",
          "allowedValues": [
            {
              "code": "1",
              "label": "yes"
            },
            {
              "code": "0",
              "label": "no"
            },
            {
              "code": "-1",
              "label": "unknown"
            }
          ],
          "provenance": {
            "kind": "import"
          }
        },
        {
          "id": "col_pain_axial",
          "name": "obs_pain_axial_intervals",
          "label": "17.1 Pain level axial",
          "description": "Axial (spine) pain level reported by the patient, in four classes.",
          "sectionId": "sec_pain",
          "dataType": "categorical",
          "allowedValues": [
            {
              "code": "0",
              "label": "no pain"
            },
            {
              "code": "1",
              "label": "low"
            },
            {
              "code": "2",
              "label": "medium"
            },
            {
              "code": "3",
              "label": "high"
            },
            {
              "code": "-1",
              "label": "unknown"
            }
          ],
          "provenance": {
            "kind": "import"
          }
        },
        {
          "id": "col_pain_axial_nrs",
          "name": "obs_pain_axial_nrs",
          "label": "17.2 NRS (if available) axial",
          "description": "Numerical Rating Scale score of axial pain, from 0 to 10.",
          "sectionId": "sec_pain",
          "dataType": "integer",
          "provenance": {
            "kind": "import"
          }
        },
        {
          "id": "col_hb",
          "name": "obs_bloodt_hb",
          "label": "24.1 Hb",
          "description": "Haemoglobin concentration in blood; unit in column obs_bloodt_hb_spec.",
          "sectionId": "sec_blood",
          "dataType": "decimal",
          "missingValues": [
            "NA"
          ],
          "provenance": {
            "kind": "import"
          }
        },
        {
          "id": "col_hb_unit",
          "name": "obs_bloodt_hb_spec",
          "label": "Specify unity measure used",
          "description": "Unit of measure used for obs_bloodt_hb.",
          "sectionId": "sec_blood",
          "dataType": "categorical",
          "allowedValues": [
            {
              "code": "1",
              "label": "g/dL"
            },
            {
              "code": "2",
              "label": "g/L"
            },
            {
              "code": "3",
              "label": "mmol/L"
            }
          ],
          "provenance": {
            "kind": "import"
          }
        }
      ]
