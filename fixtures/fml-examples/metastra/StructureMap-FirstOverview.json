  "text" : {
    "status" : "additional",
    "div" : "<div xmlns=\"http://www.w3.org/1999/xhtml\"><pre>map &quot;http://example.org/fhir/metastra/StructureMap/FirstOverview&quot; = `FirstOverview`\n\nuses &quot;http://example.org/fhir/metastra/StructureDefinition/FirstOverviewRow&quot; alias FirstOverviewRow as source\nuses &quot;http://hl7.org/fhir/StructureDefinition/Bundle&quot; alias Bundle as target\nuses &quot;http://hl7.org/fhir/StructureDefinition/Patient&quot; alias Patient as target\nuses &quot;http://hl7.org/fhir/StructureDefinition/Encounter&quot; alias Encounter as target\nuses &quot;http://hl7.org/fhir/StructureDefinition/Observation&quot; alias Observation as target\nuses &quot;http://hl7.org/fhir/StructureDefinition/Condition&quot; alias Condition as target\nuses &quot;http://hl7.org/fhir/StructureDefinition/Procedure&quot; alias Procedure as target\n\n// Main group: one transaction Bundle per normalized record.\n// Each role becomes an entry with PUT on its deterministic id (computed by the normalization).\ngroup FirstOverview(source src : FirstOverviewRow, target bundle : Bundle) {\n  src -&gt; bundle.type = 'transaction' &quot;bundle-type&quot;;\n\n  // Patient[0] · patient — always\n  src where ($this.id_Patient0.exists()) -&gt; bundle.entry as e, e.resource = create('Patient') as res, e.request as req then {\n    src.id_Patient0 as i -&gt; res.id = i, req.method = 'PUT', req.url = evaluate(i, 'Patient/' + $this), e.fullUrl = evaluate(i, 'http://example.org/fhir/metastra/Patient/' + $this) &quot;Patient0-id&quot;;\n    src then Patient0(src, res) &quot;Patient0-body&quot;;\n  } &quot;Patient0&quot;;\n\n  // Encounter[0] · first visit — created when: encounter_fo is not empty\n  src where ($this.id_Encounter0.exists() and $this.encounter_fo.exists()) -&gt; bundle.entry as e, e.resource = create('Encounter') as res, e.request as req then {\n    src.id_Encounter0 as i -&gt; res.id = i, req.method = 'PUT', req.url = evaluate(i, 'Encounter/' + $this), e.fullUrl = evaluate(i, 'http://example.org/fhir/metastra/Encounter/' + $this) &quot;Encounter0-id&quot;;\n    src then Encounter0(src, res) &quot;Encounter0-body&quot;;\n  } &quot;Encounter0&quot;;\n\n  // Observation[0] · axial pain — created when: value present and not -1 (skipInstance)\n  src where ($this.id_Observation0.exists() and ($this.obs_pain_axial_intervals.exists() and $this.obs_pain_axial_intervals.where($this = '-1').empty())) -&gt; bundle.entry as e, e.resource = create('Observation') as res, e.request as req then {\n    src.id_Observation0 as i -&gt; res.id = i, req.method = 'PUT', req.url = evaluate(i, 'Observation/' + $this), e.fullUrl = evaluate(i, 'http://example.org/fhir/metastra/Observation/' + $this) &quot;Observation0-id&quot;;\n    src then Observation0(src, res) &quot;Observation0-body&quot;;\n  } &quot;Observation0&quot;;\n\n  // Observation[1] · haemoglobin — created when: obs_bloodt_hb is not empty\n  src where ($this.id_Observation1.exists() and $this.obs_bloodt_hb.exists()) -&gt; bundle.entry as e, e.resource = create('Observation') as res, e.request as req then {\n    src.id_Observation1 as i -&gt; res.id = i, req.method = 'PUT', req.url = evaluate(i, 'Observation/' + $this), e.fullUrl = evaluate(i, 'http://example.org/fhir/metastra/Observation/' + $this) &quot;Observation1-id&quot;;\n    src then Observation1(src, res) &quot;Observation1-body&quot;;\n  } &quot;Observation1&quot;;\n\n  // Condition[1] · osteoporosis — created when: value in {1, -1} and not 0 (skipInstance)\n  src where ($this.id_Condition1.exists() and ($this.cond_osteoporosis_yn.where($this = '1' or $this = '-1').exists() and $this.cond_osteoporosis_yn.where($this = '0').empty())) -&gt; bundle.entry as e, e.resource = create('Condition') as res, e.request as req then {\n    src.id_Condition1 as i -&gt; res.id = i, req.method = 'PUT', req.url = evaluate(i, 'Condition/' + $this), e.fullUrl = evaluate(i, 'http://example.org/fhir/metastra/Condition/' + $this) &quot;Condition1-id&quot;;\n    src then Condition1(src, res) &quot;Condition1-body&quot;;\n  } &quot;Condition1&quot;;\n\n  // Procedure[0] · previous spinal surgery — created when: proc_surg_yn = 1\n  src where ($this.id_Procedure0.exists() and $this.proc_surg_yn.where($this = '1').exists()) -&gt; bundle.entry as e, e.resource = create('Procedure') as res, e.request as req then {\n    src.id_Procedure0 as i -&gt; res.id = i, req.method = 'PUT', req.url = evaluate(i, 'Procedure/' + $this), e.fullUrl = evaluate(i, 'http://example.org/fhir/metastra/Procedure/' + $this) &quot;Procedure0-id&quot;;\n    src then Procedure0(src, res) &quot;Procedure0-body&quot;;\n  } &quot;Procedure0&quot;;\n}\n\ngroup Patient0(source src : FirstOverviewRow, target res : Patient) {\n  // identifier: repeating element without a slice → one shared repetition\n  src where ($this.patient_id.exists()) -&gt; res.identifier as rep then {\n    src.patient_id as v -&gt; rep.value = v &quot;R-001&quot;;\n  } &quot;Patient0-identifier&quot;;\n  // R-002: value map administrativeGender (one rule per value; ConceptMap exported separately)\n  src.patient_gender as v where ($this = 'Female') -&gt; res.gender = 'female' &quot;R-002-Female&quot;;\n  src.patient_gender as v where ($this = 'Male') -&gt; res.gender = 'male' &quot;R-002-Male&quot;;\n  src.patient_birthdate as v -&gt; res.birthDate = v &quot;R-003&quot;;\n}\n\ngroup Encounter0(source src : FirstOverviewRow, target res : Encounter) {\n  src -&gt; res.status = 'finished' &quot;fixed-status&quot;;\n  src -&gt; res.class = c('http://terminology.hl7.org/CodeSystem/v3-ActCode', 'AMB', 'ambulatory') &quot;fixed-class&quot;;\n  src.encounter_fo as v -&gt; res.period as p, p.start = v &quot;R-004&quot;;\n  // R-005 automatic (context) reference to Patient[0]: Patient[0] is always created\n  src.id_Patient0 as t -&gt; res.subject as r, r.reference = evaluate(t, 'Patient/' + $this) &quot;R-005&quot;;\n}\n\ngroup Observation0(source src : FirstOverviewRow, target res : Observation) {\n  src -&gt; res.status = 'final' &quot;fixed-status&quot;;\n  src -&gt; res.code = cc('http://snomed.info/sct', '279039007', 'Low back pain') &quot;fixed-code&quot;;\n  // R-006: value map painLevel (one rule per value; ConceptMap exported separately)\n  src.obs_pain_axial_intervals as v where ($this = '0') -&gt; res.value = cc('http://snomed.info/sct', '373067005', 'No') &quot;R-006-0&quot;;\n  src.obs_pain_axial_intervals as v where ($this = '1') -&gt; res.value = cc('http://snomed.info/sct', '62482003', 'Low') &quot;R-006-1&quot;;\n  src.obs_pain_axial_intervals as v where ($this = '2') -&gt; res.value = cc('http://loinc.org', 'LA6751-7', 'Moderate') &quot;R-006-2&quot;;\n  src.obs_pain_axial_intervals as v where ($this = '3') -&gt; res.value = cc('http://snomed.info/sct', '75540009', 'High') &quot;R-006-3&quot;;\n  // component[nrs]: named slice, created only if the column has a value\n  src where ($this.obs_pain_axial_nrs.exists()) -&gt; res.component as slc then {\n    src -&gt; slc.code = cc('http://snomed.info/sct', '1284852002') &quot;slice-nrs-code&quot;;\n    src.obs_pain_axial_nrs as v -&gt; slc.value = v &quot;R-007&quot;;\n  } &quot;slice-nrs&quot;;\n  src.id_Patient0 as t -&gt; res.subject as r, r.reference = evaluate(t, 'Patient/' + $this) &quot;R-008&quot;;\n  // R-009 the reference honours the creation condition of Encounter[0]\n  src where ($this.encounter_fo.exists()) then {\n    src.id_Encounter0 as t -&gt; res.encounter as r, r.reference = evaluate(t, 'Encounter/' + $this) &quot;R-009&quot;;\n  } &quot;R-009-guard&quot;;\n}\n\ngroup Observation1(source src : FirstOverviewRow, target res : Observation) {\n  src -&gt; res.status = 'final' &quot;fixed-status&quot;;\n  src -&gt; res.code = cc('http://snomed.info/sct', '38082009') &quot;fixed-code&quot;;\n  src.obs_bloodt_hb as v -&gt; res.value = create('Quantity') as q then {\n    v -&gt; q.value = v &quot;R-010-value&quot;;\n    // R-010-unit: unit from the auxiliary column, value map hbUnit\n    src.obs_bloodt_hb_spec as u where ($this = '1') -&gt; q.unit = 'g/dL', q.system = 'http://unitsofmeasure.org', q.code = 'g/dL' &quot;R-010-unit-1&quot;;\n    src.obs_bloodt_hb_spec as u where ($this = '2') -&gt; q.unit = 'g/L', q.system = 'http://unitsofmeasure.org', q.code = 'g/L' &quot;R-010-unit-2&quot;;\n    src.obs_bloodt_hb_spec as u where ($this = '3') -&gt; q.unit = 'mmol/L', q.system = 'http://unitsofmeasure.org', q.code = 'mmol/L' &quot;R-010-unit-3&quot;;\n  } &quot;R-010&quot;;\n  src.id_Patient0 as t -&gt; res.subject as r, r.reference = evaluate(t, 'Patient/' + $this) &quot;subject-auto&quot;;\n  src where ($this.encounter_fo.exists()) then {\n    src.id_Encounter0 as t -&gt; res.encounter as r, r.reference = evaluate(t, 'Encounter/' + $this) &quot;encounter-auto&quot;;\n  } &quot;encounter-auto-guard&quot;;\n}\n\ngroup Condition1(source src : FirstOverviewRow, target res : Condition) {\n  src -&gt; res.code = cc('http://snomed.info/sct', '64859006') &quot;fixed-code&quot;;\n  // R-011: value map osteoStatus (one rule per value; ConceptMap exported separately)\n  src.cond_osteoporosis_yn as v where ($this = '1') -&gt; res.verificationStatus = cc('http://terminology.hl7.org/CodeSystem/condition-ver-status', 'confirmed') &quot;R-011-1&quot;;\n  src.cond_osteoporosis_yn as v where ($this = '-1') -&gt; res.verificationStatus = cc('http://terminology.hl7.org/CodeSystem/condition-ver-status', 'unconfirmed') &quot;R-011--1&quot;;\n  src.id_Patient0 as t -&gt; res.subject as r, r.reference = evaluate(t, 'Patient/' + $this) &quot;R-012&quot;;\n}\n\ngroup Procedure0(source src : FirstOverviewRow, target res : Procedure) {\n  src -&gt; res.status = 'completed' &quot;fixed-status&quot;;\n  // R-013 repeat eachValue: the normalized column is a list; each rule fires for every matching value\n  // R-013: value map spineLevel (one rule per value; ConceptMap exported separately)\n  src.proc_surg_loc as v where ($this = '1') -&gt; res.bodySite = cc('http://snomed.info/sct', '14806007') &quot;R-013-1&quot;;\n  src.proc_surg_loc as v where ($this = '2') -&gt; res.bodySite = cc('http://snomed.info/sct', '731673003') &quot;R-013-2&quot;;\n  src.proc_surg_loc as v where ($this = '8') -&gt; res.bodySite = cc('http://snomed.info/sct', '731692001') &quot;R-013-8&quot;;\n  src.proc_surg_loc as v where ($this = '20') -&gt; res.bodySite = cc('http://snomed.info/sct', '731695004') &quot;R-013-20&quot;;\n  src.id_Patient0 as t -&gt; res.subject as r, r.reference = evaluate(t, 'Patient/' + $this) &quot;R-014&quot;;\n}\n</pre></div>"
