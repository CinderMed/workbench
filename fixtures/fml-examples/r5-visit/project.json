      "code": "R-007",
      "instanceId": "ins_obs0",
      "path": "effectiveDateTime",
      "transform": {
        "kind": "constant",
        "value": {
          "type": "dateTime",
          "value": "2024-03-12T09:30:00+01:00"
        }
      }
    },
    {
      "id": "map_0008",
      "code": "R-008",
      "instanceId": "ins_obs0",
      "path": "component[d2s].valueString",
      "transform": {
        "kind": "cast",
        "to": "string"
      },
      "columnId": "col_score"
    },
    {
      "id": "map_0009",
      "code": "R-009",
      "instanceId": "ins_obs0",
      "path": "component[pain].valueInteger",
      "transform": {
