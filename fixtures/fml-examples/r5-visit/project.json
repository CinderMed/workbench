      "instanceId": "ins_cond0",
      "path": "onsetAge",
      "transform": {
        "kind": "quantity",
        "unit": {
          "system": "http://unitsofmeasure.org",
          "code": "a",
          "display": "year"
        }
      },
      "columnId": "col_age"
    },
    {
      "id": "map_0013",
      "code": "R-013",
      "instanceId": "ins_cond0",
      "path": "subject",
      "transform": {
        "kind": "reference",
        "targetInstanceId": "ins_patient0",
        "auto": true
      }
