      },
      "columnId": "col_pain"
    },
    {
      "id": "map_0010",
      "code": "R-010",
      "instanceId": "ins_obs0",
      "path": "subject",
      "transform": {
        "kind": "reference",
        "targetInstanceId": "ins_patient0",
        "auto": true
      }
    },
    {
      "id": "map_0011",
      "code": "R-011",
      "instanceId": "ins_obs0",
      "path": "encounter",
      "transform": {
        "kind": "reference",
        "targetInstanceId": "ins_encounter0",
        "auto": true
      }
    },
    {
      "id": "map_0012",
