      },
      "columnId": "col_visit_date"
    },
    {
      "id": "map_0005",
      "code": "R-005",
      "instanceId": "ins_encounter0",
      "path": "subject",
      "transform": {
        "kind": "reference",
        "targetInstanceId": "ins_patient0",
        "auto": true
      }
    },
    {
      "id": "map_0006",
      "code": "R-006",
      "instanceId": "ins_obs0",
      "path": "valueQuantity",
      "transform": {
