{
  "name": "cindermed-workbench",
  "private": true,
  "description": "CinderMed (FHIR Mapping Workbench): map tabular datasets to FHIR and generate FML",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run --coverage",
    "lint": "pnpm --filter @cindermed/docs sync && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "codegen": "node tooling/codegen/model-types-cli.ts",
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "check:fixtures": "sha256sum --check --quiet --strict fixtures/fml-examples.sha256",
    "prepare": "lefthook install",
    "golden": "bash tooling/golden/run-examples.sh",
    "changeset": "changeset",
    "version-packages": "changeset version && prettier --write --log-level warn \"**/CHANGELOG.md\" \"{apps,packages}/*/package.json\""
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "json-schema-to-typescript": "^16.0.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
